# deploy/.env on the VPS: cp env.example .env && chmod 600 .env. Git ignores .env; never commit or paste it.

# The database password. Hex only (it goes into a URL): openssl rand -hex 24
CB_PG_PASSWORD=

# Where Postgres listens for the workers' cb: the VPS's Tailscale address (tailscale ip -4). 127.0.0.1 = the VPS only.
CB_PG_BIND=127.0.0.1

# The board's public https address (what the proxy serves): links to members point here.
CB_PUBLIC_URL=https://board.example.com

# 1 only if EVERY request reaches the board through Cloudflare (a tunnel, or an orange-cloud DNS record AND the VPS's
# 80/443 closed to everyone else). Then login lockouts count Cloudflare's client address. 0: nginx's X-Forwarded-For.
CB_BEHIND_CLOUDFLARE=0

# The docker network of the proxy in front of the board (Nginx Proxy Manager's, on vps2). Optional.
CB_PROXY_NETWORK=nginx-proxy-manager_default

# This machine's name on the board (sessions, reply_to). Optional.
CB_MACHINE=vps

# The Telegram bot (optional). The same token as the PC's .env: stop the PC's board first (one poller per bot).
TELEGRAM_BOT_TOKEN=

# The GitHub watch signs in with `docker compose exec board gh auth login` (deploy.md, step 5); leave this empty.
# A token here (a fine-grained, read-only one: contents, pull requests, actions: read) overrides that login.
GH_TOKEN=

# The port the board listens on, on the VPS's loopback (curl, healthz). Optional.
CB_PORT=4747
